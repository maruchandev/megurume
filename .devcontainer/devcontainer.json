{
  "name": "Megurume Dev Container",
  "dockerComposeFile": "../compose.yaml",
  "service": "backend",
  "runServices": ["backend", "db"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "portsAttributes": {
    "8000": { "label": "Laravel", "onAutoForward": "ignore" }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",
  "postStartCommand": "bash /workspace/.devcontainer/start-app.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client"
      ]
    }
  }
}
